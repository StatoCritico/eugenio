# Copiare in .env e completare. Il file .env contiene segreti: non va nel repository (.gitignore).

# Pubblicazione: eugenio.statocritico.it e notizie.statocritico.it tramite Cloudflare Tunnel (README, "Dominio")
CLOUDFLARE_TUNNEL_TOKEN=

# cartelle sul server
CARTELLA_DATI=/srv/energia/dati
CARTELLA_SITO=/srv/energia/sito
# prodotti degli edifici 3D (fase 10), serviti da Caddy in /edifici3d/ (archivi cc-by/ e odbl/ separati)
CARTELLA_EDIFICI=/srv/energia/dati/edifici

# ambito geografico: codici ISTAT delle regioni SERVITE dal sito (08 = Emilia-Romagna), separati da virgola;
# vuoto = tutta Italia (serve l'archivio meteo nazionale della fase 3 in /srv/energia/dati)
REGIONI=08
# regioni di cui il worker aggiorna OGNI GIORNO previsioni e storico meteo (Open-Meteo, API gratuita): vuoto = tutte
# quelle servite (come prima del 07/11/2026). Es. tutta Italia servita, solo l'ER aggiornata: REGIONI= e REGIONI_AGGIORNATE=08
REGIONI_AGGIORNATE=

# Zornade (geocodifica e catasto): chiave gratuita da https://app.zornade.com/api
ZORNADE_API_KEY=

# aggiornamenti meteo
ORE_PREVISIONI=6
ORA_STORICO_UTC=5
# istanza Open-Meteo propria (profilo open-meteo del compose): http://open-meteo:8080
OPEN_METEO_LOCALE=

# limiti per gli utenti
MAX_UPLOAD_MB=5
MAX_RIGHE=200000

# ---------------------------------------------------------------- dati di mercato (fase 6)
# credenziali personali dell'API GME (gratuite): https://api.mercatoelettrico.org – password valida 6 mesi
GME_UTENTE=
GME_PASSWORD=
ORA_MERCATI=02:30
# i dati GME e TTF restano interni (simulazioni e analisi): nessuna rotta li espone
MERCATI_CONFIG=/dati/mercati/config.toml
MERCATI_ARCHIVIO=/dati/mercati

# ---------------------------------------------------------------- patrimonio edilizio (fase 7)
MAX_EDIFICI=500

# ---------------------------------------------------------------- newsletter automatica dei dati e avvisi
SITO_URL=https://eugenio.statocritico.it
NOTIZIE_URL=https://notizie.statocritico.it
LISTMONK_DB_PASSWORD=
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=
# utente API creato nel pannello di listmonk (Utenti → nuovo utente di tipo API)
LISTMONK_API_UTENTE=
LISTMONK_API_TOKEN=
# numero della lista mensile creata in listmonk (README, "Newsletter automatica dei dati")
LISTA_MENSILE=
NOTIZIARIO_INVIO_AUTOMATICO=true
NOTIZIARIO_GIORNO=3
# SMTP (OCI Email Delivery, lo stesso configurato in listmonk) per avvisi all'amministratore
SMTP_SERVER=smtp.email.eu-milan-1.oci.oraclecloud.com
SMTP_PORTA=587
SMTP_UTENTE=
SMTP_PASSWORD=
SMTP_MITTENTE=eugenio@statocritico.it
EMAIL_AMMINISTRATORE=

# ---------------------------------------------------------------- lavori periodici sui file del sito
# indicatori della sanità (fase 8): giorno del mese, dalle 6
INDICATORI_GIORNO=5
# clima dal 1940 (fase 9): giorno/mese, dalle 3 (10/7: stagione di riscaldamento finita; 10/1: anno solare finito)
CLIMA_DATE=10/01,10/07

# ---------------------------------------------------------------- report scaricabili
# formati offerti (dal 28/10/2026 solo PDF e dati grezzi); per riaccendere Word e ODT: pdf,xlsx,ods,docx,odt
REPORT_FORMATI=pdf,xlsx,ods

# ---------------------------------------------------------------- Dati storici scaricabili (limiti per file; i valori sono quelli predefiniti)
STORICI_MAX_RIGHE_CSV=500000
STORICI_MAX_RIGHE_XLSX=300000
STORICI_MAX_CELLE_XLSX=3000000
# OpenDocument (.ods): scritto in streaming, 300.000 righe × 10 colonne in ~9 s
STORICI_MAX_RIGHE_ODS=300000
STORICI_MAX_CELLE_ODS=3000000

# ---------------------------------------------------------------- protezione dell'API (servizio/protezione.py)
# verifica anti-robot Cloudflare Turnstile (dashboard Cloudflare → Turnstile → Add widget, dominio
# eugenio.statocritico.it, modalità Managed). Senza le due chiavi la verifica è spenta (prove, mirror).
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAME=eugenio.statocritico.it
# chiave per firmare i gettoni di sessione: generarla con  openssl rand -hex 32  (vuota = nuova a ogni riavvio)
SESSIONE_CHIAVE=
SESSIONE_MINUTI=30
SESSIONI_ORA=60
# limiti (valori predefiniti): rotte dei dati per IP all'ora, chiamate Zornade all'ora per tutto il sito,
# previsioni ammesse insieme (una in calcolo, una in fila) e attesa massima prima del 503
LIMITE_DATI_ORA=600
ZORNADE_TETTO_ORA=6000
ZORNADE_AVVISO_QUOTA=0.7
PREVISIONI_PARALLELE=2
PREVISIONI_ATTESA_S=30
# avviso email solo se la stessa rete supera i limiti almeno 20 volte al giorno per 3 giorni consecutivi;
# i conteggi (con gli IP) restano 7 giorni in /dati/protezione/429.json
AVVISO_429_SOGLIA=20
AVVISO_429_GIORNI=3
AVVISO_429_CONSERVA_GIORNI=7

# ---------------------------------------------------------------- ortofoto (fase 10, Fase B; servizio/ortofoto.py)
# fonti nei TOML di fase10-edifici3d/ortofoto (copiati nell'immagine). Spegnere una fonte senza toccare i TOML:
# ORTOFOTO_SPENTE=rer2023 (più fonti separate da virgola), poi riavviare l'api. ORTOFOTO_SOLO_CONFERMATE=true serve
# solo le fonti con stato «confermata» (la RER resta «da confermare» finché la Regione non risponde).
ORTOFOTO_SPENTE=
ORTOFOTO_SOLO_CONFERMATE=false
# copia delle tessere in /dati/ortofoto: validità in giorni, tetto in GB, Cache-Control verso browser e Cloudflare
ORTOFOTO_GIORNI=180
ORTOFOTO_MAX_GB=15
ORTOFOTO_CACHE_S=2592000
# (09/11/2026, prove J10: migliaia di 429) limiti per IP all'ora: ORTOFOTO_ORA e STRATI_ORA contano solo le tessere chieste
# davvero alla fonte (non in copia); TESSERE_COPIA_ORA è il tetto anti-abuso delle tessere servite dalla copia su disco
# (ortofoto, strati e terreno insieme). Il 429 porta Retry-After: la pagina ferma quella fonte e lo dice sotto la mappa.
ORTOFOTO_ORA=12000
STRATI_ORA=12000
TESSERE_COPIA_ORA=60000
# attesa massima del turno verso la fonte (una vista 3D inclinata chiede 50–80 tessere insieme), poi tessera vuota con X-Ortofoto-Errore: occupata (09/11/2026 c; prima 503)
ORTOFOTO_ATTESA_S=8
# (09/11/2026 c) tempo massimo di una chiamata alla fonte delle ortofoto (facoltativo, predefinito 12): attesa + chiamata < 30 s di Caddy
# ORTOFOTO_TIMEOUT_S=12
# strati sopra le ortofoto (05/11/2026; servizio/strati.py, TOML in fase10-edifici3d/ortofoto/strati): particelle
# catastali (catasto), contorni degli edifici (dbtr_edifici, osm_edifici). Spegnerne uno senza toccare i TOML, poi
# riavviare l'api: STRATI_SPENTI=osm_edifici (più strati separati da virgola). Stessa copia e attesa delle ortofoto; limite
# STRATI_ORA (particelle e contorni regionali) e, per le tessere OSM, quello di Overpass (EDIFICI_OSM_ORA e il tetto del sito).
STRATI_SPENTI=
# ripiego OpenStreetMap di Modelli 3D (07/11/2026; servizio/edifici_osm.py): edifici OSM intorno al punto dall'API
# Overpass dove non c'è il DBTR. false = spento (la pagina dice che il 3D qui non si può generare). Richieste per IP
# all'ora, chiamate a Overpass all'ora per tutto il sito, validità in giorni della copia su disco (/dati/edifici_osm),
# attesa del turno (una chiamata alla volta) e timeout per istanza. EDIFICI_OSM_URL vuoto = istanze dello strato osm_edifici.
EDIFICI_OSM=true
# EDIFICI_OSM_ORA: richieste che vanno davvero a Overpass o al WFS regionale (anche le tessere OSM dei «Contorni degli
# edifici»); le celle già in copia contano in EDIFICI_OSM_COPIA_ORA (09/11/2026: prima la copia consumava il limite di 60)
EDIFICI_OSM_ORA=300
EDIFICI_OSM_COPIA_ORA=3000
EDIFICI_OSM_TETTO_ORA=300
EDIFICI_OSM_GIORNI=30
EDIFICI_OSM_ATTESA_S=15
EDIFICI_OSM_TIMEOUT_S=30
EDIFICI_OSM_URL=
# Sagome regionali al volo (08/11/2026): in Veneto le sagome degli edifici dal WFS della Regione (IODL 2.0) con le
# altezze di OpenStreetMap; stessa rotta, stessa verifica anti-robot e limiti per IP del ripiego OSM, copia su disco di
# EDIFICI_OSM_GIORNI giorni in /dati/edifici_regionali. false = solo OpenStreetMap come prima.
EDIFICI_REGIONALI=true
EDIFICI_REGIONALI_TETTO_ORA=300
EDIFICI_REGIONALI_TIMEOUT_S=30
# istanza di riserva di Overpass, comune allo strato «Contorni degli edifici – OpenStreetMap» e al ripiego (07/11/2026:
# «Overpass API Europa», ovp.dresel.systems, Germania, al posto di maps.mail.ru di VK). Riga assente = la riserva del TOML
# (fase10-edifici3d/ortofoto/strati/edifici.toml); riga presente ma vuota = nessuna riserva (se dal server non risponde:
# procedura F11 bis di AGGIORNAMENTO_2026-11-07.md); più istanze separate da virgola.
#OVERPASS_RISERVA=https://ovp.dresel.systems/api/interpreter
# ---------------------------------------------------------------- PVGIS e orizzonte lontano (fase 10, Fase B)
# il JRC ammette 30 chiamate al secondo per indirizzo: qui 20 per tutto il sito; confronti per IP all'ora
PVGIS_AL_SECONDO=20
PVGIS_ORA=60
PVGIS_CACHE_GIORNI=90
# orizzonte dal Copernicus DEM 90 m (file .om di Open-Meteo su S3, come la fase 3): raggio e profili per IP all'ora
ORIZZONTE_RAGGIO_KM=25
ORIZZONTE_ORA=120
# terreno 3D su richiesta (07/11/2026): DTM in /srv/energia/dati/terreno (comando dtm-server della fase 10)
TERRENO_ATTIVO=true
TERRENO_MAX_GB=5
# tessere da generare per IP all'ora (quelle in copia contano in TESSERE_COPIA_ORA)
TERRENO_ORA=6000
TERRENO_PARALLELE=2
# ---------------------------------------------------------------- pagina di stato interna degli edifici (fase 10, Fase C)
# Cloudflare Access su /interno/* e /api/interno/* (passi in AGGIORNAMENTO_2026-11-04.md, § Fase C). Team domain
# (<team>.cloudflareaccess.com, Zero Trust → Settings → Custom Pages/Team domain) e Application Audience (AUD) Tag
# dell'applicazione Access. Senza i due valori la pagina interna risponde 503 (chiusa).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# email ammesse (facoltativo, separate da virgola): un controllo in più oltre alla policy di Access
CF_ACCESS_EMAIL=
# stato della pipeline notturna (scritto dal container edifici-lidar, letto dall'api): fuori dalla cartella pubblica
# /edifici3d/ servita da Caddy
EDIFICI_STATO=/dati/edifici_stato
INTERNO_ORA=300

# ---------------------------------------------------------------- «Aggiungi DBTR» (07/11/2026; servizio/dbtr_coda.py)
# proposte di DB topografici all'archivio comune (solo con il consenso dell'utente), preparate dal servizio edifici-coda
# e installate dopo l'approvazione nella pagina interna. false = solo lettura nel browser (le rotte /api/dbtr/* 404).
# Cartella della coda (fuori da /edifici3d/, mai servita da Caddy; scrivibile dall'utente 1000), dimensione massima di un
# file in MB, pezzo di ogni richiesta (Caddy accetta 40 MB su /api/dbtr/*, Cloudflare 100 MB), file al giorno per IP,
# pezzi all'ora per IP, richieste aperte, spazio della coda e spazio libero minimo del disco in GB.
DBTR_CODA=true
CARTELLA_CODA_DBTR=/dati/edifici_coda
DBTR_MAX_MB=300
DBTR_PEZZO_MB=32
DBTR_CARICAMENTI_GIORNO=3
DBTR_PEZZI_ORA=60
DBTR_CODA_MAX=20
DBTR_CODA_MAX_GB=4
DBTR_LIBERO_MIN_GB=10
