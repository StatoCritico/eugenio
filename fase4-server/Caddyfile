{
	# HTTPS gestito da Cloudflare: Caddy ascolta in chiaro solo dentro la rete Docker
	auto_https off
	admin off
}

:80 {
	@comprimibile not path /api/ortofoto/*
	encode @comprimibile zstd gzip

	# ortofoto (fase 10, Fase B): tessere dal proxy dell'api (servizio/ortofoto.py) con la sua copia su disco. Caddy
	# le passa senza timeout lungo e lascia le intestazioni di cache scritte dall'api (public, 30 giorni, così anche
	# Cloudflare tiene la copia; no-store per le fonti solo dal vivo); niente compressione (JPEG già compressi).
	handle /api/ortofoto/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			transport http {
				read_timeout 30s
			}
		}
		header -Set-Cookie
	}

	# pagine interne (fase 10, Fase C): stato della pipeline degli edifici. Cloudflare Access protegge /interno/* e
	# /api/interno/*; qui si rifiutano le richieste senza l'intestazione di Access, e l'api verifica il JWT (firma,
	# audience, scadenza) anche per la pagina statica, con forward_auth. Mai indicizzate né in cache.
	@senza_access not header Cf-Access-Jwt-Assertion *
	handle /api/interno/* {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		respond @senza_access "Accesso riservato" 403
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	redir /interno /interno/edifici.html
	handle /interno/* {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		respond @senza_access "Accesso riservato" 403
		forward_auth api:8000 {
			uri /api/interno/verifica
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
		root * /srv/sito
		file_server
	}

	# API (FastAPI): limite di dimensione per i CSV e IP reale del visitatore per i limiti di uso
	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			transport http {
				read_timeout 180s
			}
		}
	}

	# edifici 3D (fase 10): PMTiles dei corpi e del terreno, COG del DTM e celle di contesto, file statici letti a
	# pezzi (Range) dalla pagina 3D. Archivi separati per licenza: /edifici3d/cc-by/<zona>/… e /edifici3d/odbl/<zona>/…
	# (cartella CARTELLA_EDIFICI del .env, montata in sola lettura). file_server gestisce già Range e ETag.
	handle_path /edifici3d/* {
		root * /srv/edifici3d
		header {
			Access-Control-Allow-Origin "*"
			Access-Control-Expose-Headers "Content-Length, Content-Range, ETag"
			Cache-Control "public, max-age=86400"
		}
		@pmtiles path *.pmtiles
		header @pmtiles Content-Type "application/vnd.pmtiles"
		@tif path *.tif
		header @tif Content-Type "image/tiff; application=geotiff; profile=cloud-optimized"
		file_server
	}

	# sito statico (fase 5)
	handle {
		root * /srv/sito
		try_files {path} /index.html
		# file per gli agenti AI (06/11/2026): Markdown e llms.txt come testo UTF-8 (senza queste righe il .md
		# uscirebbe come application/octet-stream o senza charset, secondo l'immagine di Caddy)
		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@llms path /llms.txt
		header @llms Content-Type "text/plain; charset=utf-8"
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self)"
		# il sito può essere incorporato (iframe) solo da statocritico.it
		Content-Security-Policy "frame-ancestors 'self' https://statocritico.it https://*.statocritico.it"
	}
	# registro degli accessi (contiene gli IP): file a rotazione cancellati dopo 14 giorni, come dice
	# l'informativa privacy (fase5-sito/sito/privacy.html)
	log {
		output file /data/log/accessi.log {
			roll_size 10MiB
			roll_keep 20
			roll_keep_for 336h
		}
		format json
	}
}
